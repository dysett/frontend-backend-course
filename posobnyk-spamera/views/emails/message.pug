doctype html
html(lang='uk')
  head
    meta(charset='utf-8')
    meta(name='viewport', content='width=device-width, initial-scale=1')
    title= subject
  body(style='margin:0;padding:24px;background:#f5f7f1;font-family:Arial,sans-serif;color:#293d32;')
    table(role='presentation', width='100%', cellpadding='0', cellspacing='0')
      tr
        td(align='center')
          table(role='presentation', width='100%', cellpadding='0', cellspacing='0', style='max-width:600px;background:#ffffff;border:1px solid #e3e8dc;border-radius:12px;')
            tr
              td(style='padding:32px;')
                p(style='margin:0 0 24px;color:#246247;font-size:14px;font-weight:bold;') Листоноша
                h1(style='margin:0 0 24px;font-size:24px;line-height:1.4;')= subject
                each paragraph in text.split(/\n\s*\n/)
                  p(style='margin:0 0 18px;font-size:15px;line-height:1.8;white-space:pre-wrap;')= paragraph
