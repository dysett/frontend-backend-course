            "url": "{{restUrl}}/api/books/{{restBookId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 409', () => pm.response.to.have.status(409));",
                  "pm.test('ACTIVE_LOANS', () => pm.expect(pm.response.json().error.code).to.eql('ACTIVE_LOANS'));"
                ]
              }
            }
          ]
        },
        {
          "name": "R09 Повернути примірник",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{restUrl}}/api/books/{{restBookId}}/loans/{{restLoanId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "R10 Видалити тестову книжку",
          "request": {
            "method": "DELETE",
