    },
    {
      "name": "2. Товстий клієнт",
      "item": [
        {
          "name": "T01 Завершити попередній сеанс Postman",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-CSRF-Token",
                "value": "{{clientCsrf}}"
              }
            ],
            "url": "{{clientUrl}}/api/auth/logout",
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.sendRequest({url: pm.variables.get('clientUrl') + '/api/auth/session', method:'GET'}, (error, response) => {",
                  "  if (error) throw error;",
                  "  pm.collectionVariables.set('clientCsrf', response.json().data.csrfToken);",
                  "});"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Сеанс завершено або відсутній', () => pm.expect([200,401]).to.include(pm.response.code));"
                ]
              }
            }
          ]
        },
        {
          "name": "T02 Відхилити запит без авторизації — 401",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-CSRF-Token",
                "value": "{{clientCsrf}}"
              }
            ],
            "url": "{{clientUrl}}/api/books",
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 401', () => pm.response.to.have.status(401));",
                  "pm.test('AUTH_REQUIRED', () => pm.expect(pm.response.json().error.code).to.eql('AUTH_REQUIRED'));"
                ]
              }
            }
          ]
        },
        {
          "name": "T03 Отримати CSRF-токен і cookie",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{clientUrl}}/api/auth/session"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('clientCsrf', pm.response.json().data.csrfToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "T04 Увійти як адміністратор",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-CSRF-Token",
                "value": "{{clientCsrf}}"
              }
            ],
            "url": "{{clientUrl}}/api/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{adminUsername}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('clientCsrf', pm.response.json().data.csrfToken);",
                  "pm.test('Роль адміністратора', () => pm.expect(pm.response.json().data.user.role).to.eql('admin'));"
                ]
              }
            }
          ]
        },
        {
          "name": "T05 Відхилити неправильний CSRF-токен — 403",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-CSRF-Token",
                "value": "invalid"
              }
            ],
            "url": "{{clientUrl}}/api/books",
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 403', () => pm.response.to.have.status(403));",
                  "pm.test('CSRF_INVALID', () => pm.expect(pm.response.json().error.code).to.eql('CSRF_INVALID'));"
                ]
              }
            }
          ]
        },
        {
          "name": "T06 Вийти із сеансу Postman",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-CSRF-Token",
                "value": "{{clientCsrf}}"
              }
            ],
            "url": "{{clientUrl}}/api/auth/logout",
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
