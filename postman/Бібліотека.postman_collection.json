              "mode": "raw",
              "raw": "{\n  \"title\": \"Тестова книжка\",\n  \"author\": \"Тестовий автор\",\n  \"isbn\": \"{{restIsbn}}\",\n  \"publicationYear\": 2024,\n  \"genre\": \"Програмування\",\n  \"totalCopies\": 0\n}",
              "options": {
                "raw": {
                  "language": "json"
