            "url": "{{restUrl}}/api/books/{{restBookId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Тестова книжка: оновлені дані\",\n  \"author\": \"Тестовий автор\",\n  \"isbn\": \"{{restIsbn}}\",\n  \"publicationYear\": 2024,\n  \"genre\": \"Програмування\",\n  \"totalCopies\": 2\n}",
              "options": {
                "raw": {
