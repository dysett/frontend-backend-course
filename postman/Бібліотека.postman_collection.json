                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "R11 Перевірити відсутність видаленої книжки — 404",
          "request": {
            "method": "GET",
