  "item": [
    {
      "name": "1. RESTful-сервіс",
      "item": [
        {
          "name": "R01 Перевірити стан MongoDB",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{restUrl}}/api/health"
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const base = '978' + String(Date.now()).slice(-6) + String(Math.floor(Math.random()*1000)).padStart(3,'0');",
                  "const sum = [...base].reduce((s,d,i) => s + Number(d) * (i%2 ? 3 : 1), 0);",
                  "pm.collectionVariables.set('restIsbn', base + ((10 - sum%10)%10));",
                  "['restBookId','restLoanId'].forEach(key => pm.collectionVariables.unset(key));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "R02 Створити книжку",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{restUrl}}/api/books",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Тестова книжка\",\n  \"author\": \"Тестовий автор\",\n  \"isbn\": \"{{restIsbn}}\",\n  \"publicationYear\": 2024,\n  \"genre\": \"Програмування\",\n  \"totalCopies\": 2\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('restBookId', pm.response.json().data.id);",
                  "pm.test('Location містить ідентифікатор', () => pm.expect(pm.response.headers.get('Location')).to.include(pm.response.json().data.id));"
                ]
              }
            }
          ]
        },
        {
          "name": "R03 Отримати книжку за ідентифікатором",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{restUrl}}/api/books/{{restBookId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('Назва книжки', () => pm.expect(pm.response.json().data.title).to.eql('Тестова книжка'));"
                ]
              }
            }
          ]
        },
        {
          "name": "R04 Повне оновлення книжки — PUT",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
