{
  "name": "thick-client-library",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Товстий клієнт: React, Bootstrap, Express, MongoDB, сесії та AJAX",
  "engines": {
    "node": ">=22.12"
  },
  "config": {
    "mongodbMemoryServer": {
      "version": "7.0.24",
      "disablePostinstall": true
    }
  },
  "scripts": {
    "prestart": "npm run build",
    "start": "node src/server.js",
    "dev": "npm run build && node --watch src/server.js",
    "predemo": "npm run build",
    "demo": "node src/server.js --demo",
    "build": "vite build",
    "admin:create": "node scripts/create-admin.js",
    "seed": "node scripts/seed.js",
    "check": "node scripts/check.js",
    "pretest": "npm run build",
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "test:ui": "npm run build && node scripts/test-ui.js",
    "pack:submission": "npm run build && node scripts/package.js"
  },
  "dependencies": {
    "bootstrap": "5.3.8",
    "bootstrap-icons": "1.13.2",
    "connect-mongo": "6.0.0",
    "dotenv": "18.0.10",
    "express": "5.3.0",
    "express-rate-limit": "8.7.4",
    "express-session": "1.19.0",
    "helmet": "8.3.0",
    "mongodb": "7.8.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "mongodb-memory-server": "11.3.0",
    "playwright": "1.65.0",
    "vite": "8.3.8",
    "yazl": "3.3.1"
  }
}
