              "const json = pm.response.json();",
              "pm.collectionVariables.set('bookId', json.data.id);",
              "pm.test('Два вільні примірники', () => pm.expect(json.data.availableCopies).to.eql(2));",
              "pm.test('Location', () => pm.expect(pm.response.headers.get('Location')).to.eql('/api/books/' + json.data.id));"
            ]
