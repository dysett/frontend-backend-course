            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/auth/session"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.collectionVariables.set('csrfToken', pm.response.json().data.csrfToken);"
            ]
          }
        }
      ]
    },
    {
