      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.collectionVariables.set('csrfToken', pm.response.json().data.csrfToken);",
              "pm.test('Роль адміністратора', () => pm.expect(pm.response.json().data.user.role).to.eql('admin'));"
            ]
          }
        }
      ]
    },
    {
      "name": "01 Перевірка MongoDB",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/health"
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const base = '978' + String(Date.now()).slice(-6) + String(Math.floor(Math.random() * 1000)).padStart(3, '0');",
              "const sum = [...base].reduce((n, d, i) => n + Number(d) * (i % 2 ? 3 : 1), 0);",
              "pm.collectionVariables.set('testIsbn', base + ((10 - sum % 10) % 10));",
              "['bookId', 'loanId', 'secondLoanId'].forEach(k => pm.collectionVariables.unset(k));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('JSON response', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json'));",
              "const json = pm.response.json();",
              "pm.test('MongoDB працює', () => pm.expect(json.data.status).to.eql('ok'));"
            ]
          }
        }
      ]
    },
